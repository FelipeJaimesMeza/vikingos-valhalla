@page "/"
@implements IDisposable
@inject VikingosState State

<PageTitle>Registro al Valhalla</PageTitle>

<Alerta Mensaje="@State.Error" Tipo="error" OnCerrar="State.LimpiarMensajes" />
<Alerta Mensaje="@State.Exito" Tipo="exito" OnCerrar="State.LimpiarMensajes" />

<div class="grid">
    <section class="tarjeta">
        <VikingoForm />
    </section>

    <section class="tarjeta">
        <div class="titulo-seccion">
            <h2>Vikingos registrados (@State.Vikingos.Count)</h2>
            <button class="btn btn-secundario" @onclick="State.CargarAsync" disabled="@State.Cargando">Recargar</button>
        </div>
        <VikingoList />
    </section>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Suscripción al estado: cuando cambie, esta página se vuelve a dibujar.
        State.OnChange += StateHasChanged;
        await State.CargarAsync();
    }

    // Se quita la suscripción para no dejar referencias colgando (memory leak).
    public void Dispose() => State.OnChange -= StateHasChanged;
}
